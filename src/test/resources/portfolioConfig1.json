{
  "portfolioConfigurationStartDate": "2018-09-01",
  "currency": {
    "code": "INR"
  },
  "exchangesWithSecurityTypes": {
    "BSE": [
      {"code": "EQUITY"}
    ]
  },
  "portfolioInvestmentAmountLimit": 123456789,
  "portfolioCurrentSizeCalculator": "EquitiesMarketValueCalculator",
  "portfolioCurrentSizeAttribute": "market_value",
  "constituentRules": [
    {
      "type": "LoopPortfolioRule",
      "loopLabel": "loopRebalanceOverall1",
      "maxIterations": 1,
      "portfolioRules": [
        {
          "type": "FiltersRule",
          "rootFilter": {
            "type": "CompoundFilter",
            "filters": [
              {
                "type": "ExpressionFilter",
                "expression": {
                  "type": "ComparisonExpression",
                  "leftSide": {
                    "name": "listing_date",
                    "type": "Date"
                  },
                  "operator": ">=",
                  "rightSide": {
                    "type": "Date",
                    "literalValue": "2000-01-01"
                  }
                }
              },
              {
                "type": "ExpressionFilter",
                "expression": {
                  "type": "ComparisonExpression",
                  "leftSide": {
                    "name": "close_price",
                    "type": "Number"
                  },
                  "operator": ">=",
                  "rightSide": {
                    "type": "Number",
                    "literalValue": "100.00"
                  }
                }
              }
            ],
            "operator": "AND"
          }
        },
        {
          "type": "LoopPortfolioRule",
          "loopLabel": "loopWeightCapping1",
          "maxIterations": 500,
          "portfolioRules": [
            {
              "type": "WeightCalculationRule",
              "securityWeightCalculators": {
                "MarketValueSecurityWeightCalculator": "EquitiesMarketValueCalculator"
              },
              "rebalanceWeightAttributeName": "market_value_weight"
            },
            {
              "type": "WeightCappingRule",
              "securityWeightCappersWithParams": [
                {
                  "securityWeightCapperId": "EquityPortfolioAmountLimitSecurityWeightCapper"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portfolioInvestmentAmountLimitUpdated": true
}